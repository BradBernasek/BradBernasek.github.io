{
  "registryVersion": 3,
  "registryDateEastern": "2026-11-09",
  "changeLog": [
    {
      "version": 1,
      "dateEastern": "2026-11-09",
      "note": "First registry (REV 16.1 Step 0). Moved every health threshold, schedule and safety wording out of Swift and index.html into this file."
    },
    {
      "version": 2,
      "dateEastern": "2026-11-09",
      "note": "Added the numbers behind Body Check: waist-to-height bands (NICE NG246) and the NHS half-height line, waist action levels (BMJ 1995), body-fat circumference method (US DoD), resting energy (Mifflin-St Jeor)."
    },
    {
      "version": 3,
      "dateEastern": "2026-11-09",
      "note": "Added the numbers behind Body Age, the fitness tests and My Plan: waist-to-hip cut-off (WHO), cardio fitness by age (FRIEND registry), 1-minute sit-to-stand by age (Strassmann 2013), one-leg balance by age (Springer 2007), 30-second chair stand (CDC STEADI), weekly activity targets (CDC)."
    }
  ],
